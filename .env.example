# Copy this file to `.env` and fill in values. Never commit `.env`.

# --- LLM providers (Portfolio B) ---
# OpenRouter alone is enough to boot: all chains can fall back to it.
OPENROUTER_API_KEY=
# Primary official APIs (preferred when set)
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
# Extra failover
GROQ_API_KEY=
DEEPINFRA_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=

MODEL_PORTFOLIO=B
MODEL_CONFIG_DIR=config

SUPABASE_URL=https://bbckbcusqbdgcxnnimus.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Connect → ORM → copy URI. Use SESSION pooler (port 5432) for JARVIS, not 6543/pgbouncer.
# Replace [YOUR-PASSWORD] with the database password from that dialog.
DATABASE_URL=postgresql://postgres.bbckbcusqbdgcxnnimus:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

JARVIS_PROJECTS_ROOT=projects
WORKER=openhands
TASK_TIMEOUT_SEC=1800
# Portfolio B active pace is ~$50–150/mo; $20 is Portfolio C slow only
DAILY_SPEND_CAP_USD=50

# Deprecated (ignored by agent router; kept for old scripts)
# TIER0_MODEL=
# TIER1_MODEL=
# TIER2_MODEL=
# TIER3_MODEL=

